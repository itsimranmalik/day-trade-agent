# ══════════════════════════════════════════════════════════════
#  Day-Trade Research Agent — environment configuration
#  Copy this to .env and fill in your values.
#  .env is in .gitignore — never commit your real keys.
# ══════════════════════════════════════════════════════════════

# ── LLM (at least one required) ──────────────────────────────
# Primary: Google Gemini Flash (free, no credit card)
#   Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Fallback: Groq (free, no credit card)
#   Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Which to try first: gemini | groq
LLM_PROVIDER=gemini

# ── Account sizing ────────────────────────────────────────────
ACCOUNT_SIZE=10000      # Paper account in £
RISK_PCT=1              # Max risk per trade as % of account
MAX_IDEAS=2             # Max ideas per scan (1 or 2)

# ── Universe ──────────────────────────────────────────────────
# Comma-separated tickers. UK = .L suffix, India = .NS suffix, US = plain.
# Leave blank to use the built-in default (US + UK + India watchlist).
WATCHLIST=

UNIVERSE_SIZE=30        # Max tickers to analyse (watchlist + movers, deduped)
NEWS_COUNT=3            # Headlines per top mover
REQ_DELAY_MS=1200       # Delay between Yahoo requests (≈50/min floor; don't lower this)
MAX_RETRIES=3           # Retries on 429/5xx

# ── Telegram (optional) ───────────────────────────────────────
# Leave blank to disable. To set up:
#  1. Message @BotFather on Telegram → /newbot → copy token
#  2. Message your bot once, then visit:
#     https://api.telegram.org/bot<TOKEN>/getUpdates → copy chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
